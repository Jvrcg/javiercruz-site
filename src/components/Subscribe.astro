---
interface Props {
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;
---

{variant === 'full' ? (
  <section
    class="bg-gray-50 border-y border-gray-100 py-16"
    aria-labelledby="newsletter-heading-banner"
  >
    <div class="max-w-4xl mx-auto px-6">
      <h2 id="newsletter-heading-banner" class="text-xl font-bold text-gray-900 mb-2">
        Notes from Page 2
      </h2>
      <p class="text-gray-600 mb-6 max-w-xl">
        A monthly field report on performance marketing, experimentation, and what I'm learning running this site as an SEO lab.
      </p>
      <div class="beehiiv-mount max-w-xl w-full">
        <div data-beehiiv-form="26f9d689-97d8-4cbc-b827-3a4661fd40e1"></div>
      </div>
    </div>
  </section>
) : (
  <div class="border-t border-gray-100 pt-6 pb-2">
    <p class="text-sm font-semibold text-gray-900 mb-1">Notes from Page 2</p>
    <p class="text-xs text-gray-500 mb-4">
      A monthly field report on performance marketing, experimentation, and what I'm learning running this site as an SEO lab.
    </p>
    <div class="beehiiv-mount w-full">
      <div data-beehiiv-form="26f9d689-97d8-4cbc-b827-3a4661fd40e1"></div>
    </div>
  </div>
)}
