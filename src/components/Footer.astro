    <p>&copy; {year} Javier Cruz. All rights reserved.</p>
    <nav aria-label="Footer navigation">
      <ul class="flex gap-5 list-none m-0 p-0" role="list">
        <li>
          <a
            href="https://linkedin.com/in/javiercruz"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-gray-900 transition-colors"
          >
            LinkedIn
          </a>
        </li>
        <li>
          <a href="/contact" class="hover:text-gray-900 transition-colors">
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </div>
