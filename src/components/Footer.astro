---
import Subscribe from './Subscribe.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-gray-100 mt-24">
  <div class="max-w-4xl mx-auto px-6 pt-10 pb-6">

    <!-- Newsletter strip -->
    <div class="mb-8">
      <Subscribe variant="compact" />
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500 border-t border-gray-100 pt-6">
      <p>&copy; {year} Javier Cruz. All rights reserved.</p>
      <nav aria-label="Footer navigation">
        <ul class="flex gap-5 list-none m-0 p-0" role="list">
          <li>
            <a
              href="https://linkedin.com/in/javiercruz"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-gray-900 transition-colors"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-gray-900 transition-colors">
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </div>

  </div>
</footer>
