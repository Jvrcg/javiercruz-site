---
const year = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/tools', label: 'Tools' },
  { href: '/playbooks', label: 'Playbooks' },
  { href: '/lab-notes', label: 'Lab Notes' },
  { href: '/contact', label: 'Contact' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Javier Cruz Galera',
  url: 'https://jjcruzgalera.com',
  jobTitle: 'Senior Digital Marketing Manager',
  description:
    'Senior B2B paid media and demand generation marketer with 8+ years driving pipeline growth for B2B SaaS companies.',
  sameAs: ['https://www.linkedin.com/in/javiercruzgalera/', 'https://github.com/Jvrcg'],
};
---

<section class="bg-[#f8f8f7] border-t border-[#e5e5e3] py-6" aria-labelledby="newsletter-heading-banner">
  <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 id="newsletter-heading-banner" class="text-base font-semibold text-gray-900 mb-1">
        Notes from Page 2
      </h2>
      <p class="text-sm text-gray-600 max-w-md">
        A monthly field report on performance marketing, experimentation, and what I'm learning running this site as an SEO lab.
      </p>
    </div>
    <a
      href="https://notesfrompage2.beehiiv.com/subscribe"
      target="_blank"
      rel="noopener noreferrer"
      class="flex-shrink-0 bg-blue-600 text-white px-5 py-2 rounded-lg font-medium hover:bg-blue-700 transition-colors text-center text-sm"
    >
      Subscribe
    </a>
  </div>
</section>

<footer class="bg-[#1a1a19] border-t border-[#2c2c2a]" style="font-family: inherit;">
  <div class="max-w-4xl mx-auto px-6" style="padding-top: 48px; padding-bottom: 32px;">

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
      <!-- Left column -->
      <div>
        <p class="text-lg" style="font-weight: 500; color: #ffffff;">Javier Cruz Galera</p>
        <p class="text-sm leading-relaxed mt-2 max-w-sm" style="color: #9b9a97;">
          Senior B2B paid media and demand generation marketer with 8+ years driving pipeline
          growth for B2B SaaS companies including Fivetran and Great Place to Work.
        </p>
        <p class="mt-4 text-sm">
          <a href="https://www.linkedin.com/in/javiercruzgalera/" target="_blank" rel="noopener noreferrer" class="footer-social-link" style="color: #2563EB;">LinkedIn</a> <a href="https://github.com/Jvrcg" target="_blank" rel="noopener noreferrer" class="footer-social-link" style="color: #2563EB;">GitHub</a>
        </p>
      </div>

      <!-- Right column -->
      <div class="sm:text-right">
        <nav aria-label="Footer navigation">
          <ul class="list-none m-0 p-0 flex flex-col gap-2" role="list">
            {navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  style="font-size: 14px; color: #9b9a97;"
                  class="footer-nav-link"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <!-- Bottom row -->
    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mt-10 pt-6 border-t"
      style="border-color: #2c2c2a;"
    >
      <p style="font-size: 12px; color: #6b6a68;">&copy; {year} Javier Cruz Galera</p>
      <a href="/sitemap.xml" style="font-size: 12px; color: #6b6a68;">Sitemap</a>
    </div>

  </div>

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</footer>

<style>
  .footer-nav-link:hover {
    color: #ffffff;
  }

  .footer-social-link:hover {
    color: #3b82f6;
  }
</style>
