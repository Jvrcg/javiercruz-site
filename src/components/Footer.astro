---
import Subscribe from './Subscribe.astro';

const year = new Date().getFullYear();
---

<footer class="bg-[#0A0A0A] mt-24">
  <div class="max-w-4xl mx-auto px-6 pt-10 pb-8">

    <!-- Newsletter strip -->
    <div class="mb-8">
      <Subscribe variant="compact" />
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500 pt-6">
      <p class="text-gray-500">&copy; {year} Javier Cruz Galera. All rights reserved.</p>
      <nav aria-label="Footer navigation">
        <ul class="flex gap-5 list-none m-0 p-0" role="list">
          <li>
            <a
              href="https://linkedin.com/in/javiercruz"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-white transition-colors"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a href="/newsletter" class="text-gray-400 hover:text-white transition-colors">
              Newsletter
            </a>
          </li>
        </ul>
      </nav>
    </div>

  </div>
</footer>
