---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Newsletter — Notes from Page 2 | Javier Cruz"
  description="Notes from Page 2 is a monthly field report on performance marketing, experimentation, and what Javier Cruz is learning running this site as an SEO lab."
>

  <section class="max-w-2xl mx-auto px-6 py-20">

    <header class="mb-10">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Newsletter</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">
        Notes from Page 2
      </h1>
      <p class="text-lg text-gray-600">
        A monthly field report on performance marketing, experimentation, and what I'm learning
        running this site as an SEO lab.
      </p>
    </header>

    <div class="mt-8">
      <a
        href="https://notesfrompage2.beehiiv.com/subscribe"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700 transition-colors"
      >
        Subscribe
      </a>
    </div>

    <section class="mt-12 space-y-4 text-gray-600" aria-labelledby="what-to-expect">
      <h2 id="what-to-expect" class="text-base font-semibold text-gray-900">What to expect</h2>
      <ul class="space-y-2 list-none p-0">
        <li class="flex gap-2"><span class="text-blue-600">—</span> One issue per month, no filler</li>
        <li class="flex gap-2"><span class="text-blue-600">—</span> Practitioner-level takes on performance marketing</li>
        <li class="flex gap-2"><span class="text-blue-600">—</span> Lab results: what's working on this site, what isn't</li>
        <li class="flex gap-2"><span class="text-blue-600">—</span> No sponsored content</li>
      </ul>
    </section>

  </section>
</BaseLayout>
