---
import BaseLayout from '../../layouts/BaseLayout.astro';

const caseStudies = [
  {
    slug: 'saas-pipeline-growth',
    tag: 'Paid Search',
    title: '[Company A]: 3x Pipeline from Google Ads',
    description: 'Rebuilt a fragmented paid search program to generate $[X]M in qualified pipeline within 6 months — without increasing budget.',
    results: ['3x pipeline', '$[X]M generated', '[X]% lower CPL'],
  },
  {
    slug: 'linkedin-cac-reduction',
    tag: 'Paid Social',
    title: '[Company B]: 40% LinkedIn CAC Reduction',
    description: 'Restructured audience segmentation and creative testing to dramatically lower cost per opportunity on LinkedIn.',
    results: ['40% lower CAC', '[X]% more SQLs', '[X]% CTR lift'],
  },
  {
    slug: 'full-funnel-attribution',
    tag: 'Marketing Operations',
    title: '[Company C]: Full-Funnel Attribution Overhaul',
    description: 'Built a revenue attribution model that gave leadership visibility into which channels actually drove closed-won revenue.',
    results: ['100% attribution coverage', '[X]% budget reallocation', 'Board-ready reporting'],
  },
];
---

<BaseLayout
  title="Case Studies — Javier Cruz"
  description="Real-world B2B SaaS marketing results — paid search, LinkedIn advertising, demand generation, and marketing operations case studies."
>
  <section class="max-w-4xl mx-auto px-6 py-20">

    <header class="mb-16">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Work</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-6">Case Studies</h1>
      <p class="text-lg text-gray-600 max-w-xl">
        A selection of results-driven marketing programs across paid media, demand generation,
        and marketing operations. Details anonymized where necessary.
      </p>
    </header>

    <ol class="space-y-8 list-none p-0" role="list" aria-label="Case study list">
      {caseStudies.map((cs, i) => (
        <li>
          <a
            href={`/case-studies/${cs.slug}`}
            class="group block border border-gray-100 rounded-xl p-8 hover:border-blue-200 hover:shadow-sm transition-all"
          >
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <p class="text-xs font-medium text-blue-600 uppercase tracking-wide mb-2">{cs.tag}</p>
                <h2 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                  {cs.title}
                </h2>
              </div>
              <span class="flex-shrink-0 text-2xl font-bold text-gray-200 select-none">
                0{i + 1}
              </span>
            </div>
            <p class="text-gray-600 mb-6">{cs.description}</p>
            <ul class="flex flex-wrap gap-2 list-none p-0" role="list" aria-label="Key results">
              {cs.results.map(r => (
                <li>
                  <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">
                    {r}
                  </span>
                </li>
              ))}
            </ul>
          </a>
        </li>
      ))}
    </ol>

  </section>
</BaseLayout>
