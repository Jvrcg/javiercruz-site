---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Writing — Javier Cruz"
  description="B2B SaaS marketing perspectives on paid media, demand generation, and revenue marketing from Javier Cruz."
>
  <section class="max-w-2xl mx-auto px-6 py-20">

    <header class="mb-16">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Writing</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-6">Perspectives</h1>
      <p class="text-lg text-gray-600">
        Occasional writing on B2B paid media, demand generation, and what I've learned
        building marketing programs at SaaS companies.
      </p>
    </header>

    <!-- Empty state — replace with post list when you have content -->
    <div class="border border-dashed border-gray-200 rounded-xl p-12 text-center">
      <p class="text-gray-400 text-sm">
        Posts coming soon. In the meantime, connect with me on
        <a
          href="https://linkedin.com/in/javiercruz"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-600 hover:text-blue-700 transition-colors"
        >
          LinkedIn
        </a>
        where I share shorter-form marketing takes.
      </p>
    </div>

    <!--
    When you're ready to add posts, paste this block and replace the empty state above:

    <ol class="space-y-8 list-none p-0" role="list">
      {posts.map(post => (
        <li>
          <a href={`/writing/${post.slug}`} class="group block">
            <time class="text-xs text-gray-400" datetime={post.date}>{post.displayDate}</time>
            <h2 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors mt-1 mb-2">
              {post.title}
            </h2>
            <p class="text-gray-600 text-sm">{post.excerpt}</p>
          </a>
        </li>
      ))}
    </ol>
    -->

  </section>
</BaseLayout>
