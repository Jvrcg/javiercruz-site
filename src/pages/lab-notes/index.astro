---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('lab-notes')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  title="Lab Notes | Javier Cruz Galera"
  description="Documented results from running this site as a public SEO and GEO experiment. What was tested, what changed, and what the data shows."
>

  <section class="max-w-2xl mx-auto px-6 py-20">

    <header class="mb-14">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Lab Notes</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">Lab Notes</h1>
      <p class="text-gray-600">
        This site is an SEO and GEO experiment. Here's what's being tested, what's changed,
        and what the data shows, including the things that don't work.
      </p>
    </header>

    {posts.length > 0 ? (
      <ol class="space-y-10 list-none p-0" role="list">
        {posts.map(post => {
          const displayDate = post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <li>
              <article>
                <a href={`/lab-notes/${post.id}`} class="group block">
                  <time
                    class="text-xs text-gray-400 mb-2 block"
                    datetime={post.data.publishDate.toISOString()}
                  >
                    {displayDate}
                  </time>
                  <h2 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">
                    {post.data.title}
                  </h2>
                  <p class="text-gray-600 text-sm leading-relaxed">{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <ul class="flex flex-wrap gap-2 list-none p-0 mt-3" role="list">
                      {post.data.tags.map(tag => (
                        <li>
                          <span class="text-xs font-medium bg-gray-100 text-gray-600 px-2 py-1 rounded">
                            {tag}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </a>
              </article>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="text-gray-500">First posts coming soon.</p>
    )}

  </section>
</BaseLayout>
