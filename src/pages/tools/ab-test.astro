---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ABTestCalculator from '../../components/tools/ABTestCalculator.jsx';
---

<BaseLayout
  title="A/B Test Statistical Significance Calculator"
  description="A frequentist z-test calculator built for paid media and growth marketers. Enter your visitor and conversion counts for each variation, select your confidence threshold, and get a plain-English result."
>
  <article class="max-w-2xl mx-auto px-6 py-20">
    <header class="mb-10">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Tools</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">
        A/B Test Statistical Significance Calculator
      </h1>
      <h2 class="text-xl font-normal text-gray-700 leading-snug mb-4">
        Know when your test has enough data to call a winner — and when to keep running.
      </h2>
      <p class="text-gray-600 leading-relaxed">
        A frequentist z-test calculator built for paid media and growth marketers. Enter your visitor and conversion counts for each variation, select your confidence threshold, and get a plain-English result.
      </p>
    </header>

    <ABTestCalculator client:load />
  </article>
</BaseLayout>
