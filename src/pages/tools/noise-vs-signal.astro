---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoiseSignal from '../../components/tools/NoiseSignal.jsx';

// PLACEHOLDER: Javier to provide the subheading and the description (used as the intro paragraph and the meta description).
const subheading = '[Subheading goes here]';
const description = '[Intro paragraph goes here]';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Noise vs Signal Calculator',
  description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://jjcruzgalera.com/tools/noise-vs-signal',
  author: {
    '@type': 'Person',
    name: 'Javier Cruz Galera',
    url: 'https://jjcruzgalera.com',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  title="Noise vs Signal Calculator: Find Real Changes in Your Marketing Data"
  description={description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>
  <article class="max-w-4xl mx-auto px-6 py-20">
    <header class="mb-10">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Tools</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">
        Noise vs Signal
      </h1>
      <h2 class="text-xl font-normal text-gray-700 leading-snug mb-4">
        {subheading}
      </h2>
      <p class="text-gray-600 leading-relaxed">
        {description}
      </p>
    </header>

    <NoiseSignal client:load />
  </article>
</BaseLayout>
