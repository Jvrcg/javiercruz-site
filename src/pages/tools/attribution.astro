---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AttributionTool from '../../components/AttributionTool.jsx';
---

<BaseLayout
  title="Syncflow Attribution Simulator"
  description="A mock B2B paid media attribution and pipeline simulator built on 2024–2026 benchmark data."
>
  <article class="max-w-4xl mx-auto px-6 py-20">
    <header class="mb-12">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Tools</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">
        Syncflow Attribution Simulator
      </h1>
      <h2 class="text-xl font-normal text-gray-700 leading-snug mb-4">
        Everything you will need to communicate paid media performance to senior leadership across a full fiscal year.
      </h2>
      <p class="text-sm text-gray-500 mb-4">
        Read the methodology: <a href="/playbooks/build-your-own-attribution-dashboard" class="text-blue-600">Build Your Own B2B Paid Media Attribution Dashboard in Google Sheets</a>
      </p>
      <p class="text-gray-700 leading-relaxed">
        A full-year B2B paid media operating framework built on 2024-2026 benchmark data. Toggle attribution models, track pacing against seasonality-adjusted goals, and stress-test channel efficiency, then download the template and run the same analysis on your own numbers.
      </p>
    </header>

    <AttributionTool client:load />
  </article>
</BaseLayout>
