---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AttributionTool from '../../components/AttributionTool.jsx';
---

<BaseLayout
  title="Syncflow Attribution Simulator"
  description="A mock B2B paid media attribution and pipeline simulator built on 2024–2026 benchmark data."
>
  <article class="max-w-4xl mx-auto px-6 py-20">
    <header class="mb-12">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Tools</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">
        Syncflow Attribution Simulator
      </h1>
      <p class="text-gray-700 leading-relaxed">
        A mock B2B paid media attribution and pipeline simulator built on 2024–2026 benchmark data.
      </p>
    </header>

    <AttributionTool client:load />
  </article>
</BaseLayout>
