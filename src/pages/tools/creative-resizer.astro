---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CreativeResizer from '../../components/tools/creative-resizer/CreativeResizer.jsx';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Creative Resizer',
  description:
    'A client-side image resize, crop, and export tool for paid media creative. Processing happens entirely in the browser: there is no upload, no server processing, and no API call.',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  url: 'https://jjcruzgalera.com/tools/creative-resizer',
  author: {
    '@type': 'Person',
    name: 'Javier Cruz Galera',
    url: 'https://jjcruzgalera.com',
  },
};
---

<BaseLayout
  title="Creative Resizer"
  description="A client-side image resize, crop, and export tool for paid media creative. No uploads, everything happens in your browser."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>
  <div class="max-w-[1600px] mx-auto px-6">
    <header class="pt-12 pb-6">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Tools</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">Creative Resizer</h1>
      <h2 class="max-w-2xl text-xl font-normal text-gray-700 leading-snug mb-4">
        Resize, crop, and export paid media creative across multiple aspect ratios at once, entirely in your browser.
      </h2>
      <p class="max-w-2xl text-gray-600 leading-relaxed">
        Upload an image, generate the output sizes you need, and export. Nothing leaves your browser: there is no upload, no server processing, and no API call.
      </p>
    </header>
    <CreativeResizer client:load />
  </div>
</BaseLayout>
