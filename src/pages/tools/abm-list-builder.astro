---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ABMListBuilder from '../../components/tools/ABMListBuilder.jsx';
---

<BaseLayout
  title="ABM List Builder"
  description="Upload your customer list, get it tiered with a reason for every account, and copy a ready-to-run prompt that asks your LLM for lookalike accounts. Runs entirely in your browser."
>
  <article class="max-w-4xl mx-auto px-6 py-20">
    <header class="mb-10">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Tools</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">
        ABM List Builder
      </h1>
      <h2 class="text-xl font-normal text-gray-700 leading-snug mb-4">
        Turn your best customers into a lookalike target list.
      </h2>
      <p class="text-gray-600 leading-relaxed">
        Upload your customer list, get it tiered with a reason for every account, and copy a ready-to-run prompt that asks your LLM for lookalike accounts. Runs entirely in your browser.
      </p>
    </header>

    <ABMListBuilder client:load />
  </article>
</BaseLayout>
