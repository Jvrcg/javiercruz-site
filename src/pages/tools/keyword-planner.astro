function classifyIntent(kw){const k=kw.toLowerCase();if(intentSignals.bofu.some(s=>k.includes(s)))return 'bofu';if(intentSignals.mofu.some(s=>k.includes(s)))return 'mofu';return 'tofu';}
function intentLabel(i){return i==='bofu'?'Bottom funnel':i==='mofu'?'Mid funnel':'Top funnel';}
function intentClass(i){return i==='bofu'?'intent-bofu':i==='mofu'?'intent-mofu':'intent-tofu';}
function parseTitles(r){return r.split(',').map(t=>t.trim()).filter(Boolean).slice(0,15);}
function buildFnGrid(gridId,placeholderId,countId,warningId,otherNoteId,titlesInputId,titlesNoteId){const grid=document.getElementById(gridId);const placeholder=document.getElementById(placeholderId);grid.innerHTML='';grid.style.display='grid';placeholder.style.display='none';JOB_FUNCTIONS.forEach(fn=>{const item=document.createElement('label');item.className='fn-item';item.innerHTML=`<input type="checkbox" value="${fn.value}" onchange="handleFnChange('${gridId}','${countId}','${warningId}','${otherNoteId}','${titlesInputId}','${titlesNoteId}')"> ${fn.label}`;grid.appendChild(item);});}
function handleFnChange(gridId,countId,warningId,otherNoteId,titlesInputId,titlesNoteId){const selected=getSelectedFunctions(gridId);const count=selected.length;const countEl=document.getElementById(countId);const warnEl=document.getElementById(warningId);const otherNote=document.getElementById(otherNoteId);const titlesInput=document.getElementById(titlesInputId);const titlesNote=document.getElementById(titlesNoteId);countEl.textContent=count>0?count+' function'+(count>1?'s':'')+' selected':'';if(count>=4){warnEl.innerHTML='<div class="warn-note" style="margin-top:6px">Selecting 4 or more functions will generate a large number of variants. Consider narrowing your selection or using fewer seed keywords for cleaner output.</div>';}else{warnEl.innerHTML='';}const hasOther=selected.includes('other');otherNote.style.display=hasOther?'block':'none';if(hasOther){titlesInput.style.borderColor='#E24B4A';titlesNote.className='required-note';titlesNote.textContent='Required when "Other" is selected. Add up to 15 titles separated by commas.';}else{titlesInput.style.borderColor='';titlesNote.className='optional-note';titlesNote.textContent='Optional but recommended. Up to 15 titles separated by commas. Sharpens exact match variants and doubles as your LinkedIn and Customer Match seed list.';}}
function getSelectedFunctions(gridId){return [...document.getElementById(gridId).querySelectorAll('input[type=checkbox]:checked')].map(c=>c.value);}
function switchTab(name,btn){['manual','csv','topic','audit'].forEach(t=>{const el=document.getElementById('kt-tab-'+t);if(el)el.style.display=t===name?'block':'none';});document.querySelectorAll('.kt-tab').forEach(b=>b.classList.remove('active'));btn.classList.add('active');}
function switchAuditMode(mode,btn){['auditMode','negMode'].forEach(m=>{const el=document.getElementById(m);if(el)el.style.display=m===mode?'block':'none';});btn.closest('.kt-tab-row').querySelectorAll('.kt-tab').forEach(b=>b.classList.remove('active'));btn.classList.add('active');}
function toggleExplainer(bodyId,chevId){const body=document.getElementById(bodyId);const open=body.classList.toggle('open');const chev=document.getElementById(chevId);if(chev)chev.style.transform=open?'rotate(90deg)':'';}
function groupIntoCampaigns(seeds){const competitor=seeds.filter(s=>negSignals.competitor.some(n=>s.toLowerCase().includes(n)));const nonBrand=seeds.filter(s=>!competitor.includes(s));const bofuSeeds=nonBrand.filter(s=>classifyIntent(s)==='bofu');const midSeeds=nonBrand.filter(s=>classifyIntent(s)!=='bofu');const campaigns=[];if(nonBrand.length){const adgroups=[];if(bofuSeeds.length)adgroups.push({name:'High intent / evaluation',seeds:bofuSeeds});if(midSeeds.length){const chunks=[];for(let i=0;i<midSeeds.length;i+=3)chunks.push(midSeeds.slice(i,i+3));chunks.forEach((c,i)=>adgroups.push({name:'Category / solution (group '+(i+1)+')',seeds:c}));}campaigns.push({name:'Non-brand search',type:'Search',bidRec:'Start Max Conversions -- graduate to tCPA once 30+ conversions/month',adgroups});}if(competitor.length)campaigns.push({name:'Competitor',type:'Search',bidRec:'Separate budget -- dedicated LP per competitor required',adgroups:[{name:'Competitor comparisons',seeds:competitor}]});return campaigns;}
function renderPreview(seeds,titles,containerId){const campaigns=groupIntoCampaigns(seeds);const bofuCount=seeds.filter(s=>classifyIntent(s)==='bofu').length;const mofuCount=seeds.filter(s=>classifyIntent(s)==='mofu').length;const tofuCount=seeds.length-bofuCount-mofuCount;let bidAdvice='Mostly top-funnel seeds. Start with Max Conversions, build data before setting tCPA.';if(bofuCount>mofuCount&&bofuCount>tofuCount)bidAdvice='Strong BOFU signal. Move to tCPA sooner -- anchor to cost per qualified opportunity.';else if(mofuCount>=bofuCount)bidAdvice='Mixed intent. Keep ad groups separate so Smart Bidding learns independently per group.';let html=`<div class="kt-preview"><p class="kt-preview-title">Campaign architecture preview</p><p class="kt-preview-sub">Structured by intent, not topic -- per Google best practice for B2B Search.</p><div class="funnel-bar"><div class="funnel-cell funnel-bofu"><div class="funnel-count">${bofuCount}</div><div class="funnel-label">Bottom funnel</div></div><div class="funnel-cell funnel-mofu"><div class="funnel-count">${mofuCount}</div><div class="funnel-label">Mid funnel</div></div><div class="funnel-cell funnel-tofu"><div class="funnel-count">${tofuCount}</div><div class="funnel-label">Top funnel</div></div></div>`;campaigns.forEach(c=>{html+=`<div class="campaign-block"><div class="campaign-name">${c.name} <span style="font-size:11px;font-weight:400;color:#9ca3af;margin-left:6px">${c.type}</span></div><div class="campaign-meta">Bid strategy: ${c.bidRec}</div>`;c.adgroups.forEach(ag=>{html+=`<div class="adgroup-row"><span class="adgroup-name">${ag.name}</span><span class="adgroup-kws">${ag.seeds.join(', ')}</span></div>`;});html+=`</div>`;});html+=`<div class="bid-rec"><strong style="color:#111827">Bidding recommendation:</strong> ${bidAdvice}</div>`;if(titles.length)html+=`<div class="cross-channel"><p class="cross-channel-title">Cross-channel audience seed</p><p class="cross-channel-sub">Included in CSV export as LinkedIn audience layer and Customer Match seed.</p><div>${titles.map(t=>`<span class="title-tag">${t}</span>`).join('')}</div></div>`;html+=`</div>`;document.getElementById(containerId).innerHTML=html;}
function renderPerFunctionClusters(seeds,selectedFns,titles,useE,useP,useB,outId){const negs=['jobs','salary','free','open source','tutorial','certification','reddit','what is','course','training','github','freeware'];const exportLines=['type,value,intent,cluster,job_function,layer','--- KEYWORDS ---,,,,,'];let html='';selectedFns.forEach(fnKey=>{const mods=personaModifiers[fnKey];html+=`<div style="margin-bottom:20px"><div class="kt-group-header"><span class="kt-group-label">${mods.label}</span><span class="kt-group-badge">${seeds.length} seed${seeds.length>1?'s':''}</span></div>`;seeds.forEach(seed=>{const intent=classifyIntent(seed);const bofu=mods.bofu.map(m=>seed+' '+m);const mofu=mods.mofu.map(m=>seed+' '+m);const titleVariants=titles.length&&mods.titleMod.length?mods.titleMod.slice(0,2).map(m=>seed+' '+m):[];html+=`<div class="kt-card"><div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px;margin-bottom:10px"><span style="font-size:15px;font-weight:500;color:#111827">${seed}</span><span class="intent-pill ${intentClass(intent)}">${intentLabel(intent)}</span></div>`;if(useE){const eks=['['+seed+']',...bofu.slice(0,4).map(k=>'['+k+']')];html+=`<span class="kt-label">Exact match</span><div style="margin-bottom:8px">`;eks.forEach(k=>{html+=`<span class="kw-tag kw-exact">${k}</span>`;exportLines.push(`exact,"${k}",bofu,"${seed}","${mods.label}",keyword`);});if(titleVariants.length)titleVariants.forEach(k=>{html+=`<span class="kw-tag kw-title">[${k}]</span>`;exportLines.push(`exact,"[${k}]",bofu,"${seed}","${mods.label}",title-informed`);});html+=`</div>`;}if(useP){const pks=['"'+seed+'"',...mofu.slice(0,4).map(k=>'"'+k+'"')];html+=`<span class="kt-label">Phrase match</span><div style="margin-bottom:8px">`;pks.forEach(k=>{html+=`<span class="kw-tag kw-phrase">${k}</span>`;exportLines.push(`phrase,"${k}",mofu,"${seed}","${mods.label}",keyword`);});html+=`</div>`;}if(useB){html+=`<span class="kt-label">Broad match (signal discovery only)</span><div style="margin-bottom:8px"><span class="kw-tag kw-broad">${seed}</span></div>`;exportLines.push(`broad,${seed},tofu,"${seed}","${mods.label}",keyword`);}html+=`<span class="kt-label">Suggested negatives</span><div>`;negs.forEach(n=>{html+=`<span class="kw-tag kw-neg">-${n}</span>`;exportLines.push(`negative,-${n},,"${seed}","${mods.label}",keyword`);});html+=`</div></div>`;});html+=`</div>`;});if(titles.length){exportLines.push('');exportLines.push('--- AUDIENCE SEED (LinkedIn + Customer Match) ---,,,,,');titles.forEach(t=>exportLines.push(`job_title,"${t}",,,,audience`));}const csv=exportLines.join('\n');html+=`<span class="kt-label" style="margin-top:8px">Export (CSV -- keywords by job function + audience seed)</span><div class="kt-export">${csv}</div><button class="kt-copy-btn" onclick="copyCSV('${outId}')">Copy CSV</button>`;document.getElementById(outId).innerHTML=html;window['_csv_'+outId]=csv;}
function copyCSV(id){const csv=window['_csv_'+id];if(csv)navigator.clipboard.writeText(csv).then(()=>{const b=document.querySelector('.kt-copy-btn');if(b){b.textContent='Copied';setTimeout(()=>b.textContent='Copy CSV',2000);}});}
function buildManual(){const raw=document.getElementById('seedInput').value.trim();const selectedFns=getSelectedFunctions('manualFnGrid');const titlesRaw=document.getElementById('titlesInput').value.trim();const useE=document.getElementById('chkE').checked;const useP=document.getElementById('chkP').checked;const useB=document.getElementById('chkB').checked;if(!raw){document.getElementById('manualPreview').innerHTML='';document.getElementById('manualOut').innerHTML='<p style="font-size:13px;color:#6b7280">Enter at least one seed keyword.</p>';return;}if(selectedFns.length===0){document.getElementById('manualPreview').innerHTML='';document.getElementById('manualOut').innerHTML='<div class="warn-note">Select at least one job function to build clusters.</div>';return;}if(selectedFns.includes('other')&&!titlesRaw){document.getElementById('manualOut').innerHTML='<div class="warn-note">Job titles are required when "Other" is selected. Please enter at least one job title above.</div>';return;}const seeds=raw.split('\n').map(s=>s.trim()).filter(Boolean);const titles=parseTitles(titlesRaw);renderPreview(seeds,titles,'manualPreview');renderPerFunctionClusters(seeds,selectedFns,titles,useE,useP,useB,'manualOut');}
function analyzeCSV(){const raw=document.getElementById('csvInput').value.trim();if(!raw){document.getElementById('csvOut').innerHTML='<p style="font-size:13px;color:#6b7280">Paste CSV data first.</p>';return;}const lines=raw.split('\n').map(l=>l.trim()).filter(Boolean);if(lines.length<2){document.getElementById('csvOut').innerHTML='<p style="font-size:13px;color:#6b7280">Need at least a header row and one data row.</p>';return;}const headers=lines[0].split(',').map(h=>h.trim().toLowerCase());const kwIdx=headers.findIndex(h=>h.includes('keyword'));const convIdx=headers.findIndex(h=>h.includes('conv'));const costIdx=headers.findIndex(h=>h.includes('cost'));const isIdx=headers.findIndex(h=>h.includes('impr')||h.includes('share'));if(kwIdx===-1){document.getElementById('csvOut').innerHTML='<p style="font-size:13px;color:#6b7280">Could not find a Keyword column. Check your CSV header row.</p>';return;}const rows=[];for(let i=1;i<lines.length;i++){const cols=lines[i].split(',');const kw=(cols[kwIdx]||'').trim().replace(/^["']|["']$/g,'');if(!kw)continue;const conv=parseFloat(cols[convIdx])||0;const cost=parseFloat(cols[costIdx])||0;const is=isIdx>=0?parseFloat(cols[isIdx])||0:null;const cpa=conv>0?Math.round(cost/conv):null;rows.push({kw,conv,cost,cpa,is,intent:classifyIntent(kw)});}const converting=rows.filter(r=>r.conv>0).sort((a,b)=>b.conv-a.conv);const nonConverting=rows.filter(r=>r.conv===0);const hasBOFU=rows.some(r=>r.intent==='bofu'&&r.conv>0);const hasMOFU=rows.some(r=>r.intent==='mofu'&&r.conv>0);const hasAnyBOFU=rows.some(r=>r.intent==='bofu');const gaps=[];if(!hasBOFU)gaps.push('No converting BOFU keywords -- missing evaluation-stage coverage (pricing, demo, alternatives, vs)');if(!hasMOFU)gaps.push('No converting MOFU keywords -- mid-funnel is underrepresented, limiting demand capture');if(!hasAnyBOFU)gaps.push('No bottom-funnel keywords in account at all -- add demo, pricing, and competitor comparison terms');function getISFlag(r){if(r.is===null)return '';const hi=r.is>0.6,cv=r.conv>0;if(hi&&cv)return '<span class="is-flag is-protect">Protect and deepen</span>';if(!hi&&cv)return '<span class="is-flag is-scale">Scale opportunity</span>';if(hi&&!cv)return '<span class="is-flag is-efficiency">Efficiency problem</span>';return '<span class="is-flag is-deprioritize">Deprioritize</span>';}let html='';if(gaps.length){html+=`<div style="margin-bottom:14px"><span class="kt-label">Funnel gaps identified</span>`;gaps.forEach(g=>{html+=`<div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:6px"><span class="gap-flag">Gap</span><span style="font-size:13px;color:#6b7280">${g}</span></div>`;});html+=`</div>`;}html+=`<span class="kt-label">Converting keywords (${converting.length}) -- ranked by volume</span>`;converting.forEach(r=>{html+=`<div class="perf-card"><div style="display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:6px"><span style="font-size:14px;font-weight:500;color:#111827">${r.kw}</span><span class="intent-pill ${intentClass(r.intent)}">${intentLabel(r.intent)}</span>${getISFlag(r)}</div><div class="perf-metrics"><span class="perf-metric">Conversions: <strong>${r.conv}</strong></span><span class="perf-metric">Cost: <strong>$${Math.round(r.cost)}</strong></span>${r.cpa!==null?`<span class="perf-metric">CPA: <strong>$${r.cpa}</strong></span>`:''} ${r.is!==null?`<span class="perf-metric">Impr. share: <strong>${Math.round(r.is*100)}%</strong></span>`:''}</div></div>`;});if(nonConverting.length){html+=`<span class="kt-label" style="margin-top:4px">Zero-conversion keywords (${nonConverting.length}) -- review for negative or restructure</span>`;nonConverting.forEach(r=>{html+=`<div style="display:flex;align-items:center;flex-wrap:wrap;gap:6px;padding:6px 0;border-bottom:0.5px solid #f3f4f6"><span style="font-size:13px;color:#6b7280">${r.kw}</span><span class="intent-pill ${intentClass(r.intent)}" style="font-size:10px">${intentLabel(r.intent)}</span>${getISFlag(r)}<span style="font-size:11px;color:#9ca3af">$${Math.round(r.cost)} spent</span></div>`;});}const seeds=converting.slice(0,10).map(r=>r.kw);if(seeds.length){html+=`<span class="kt-label" style="margin-top:16px">Expansion clusters from top performers</span><div id="csvPreviewInner"></div>`;document.getElementById('csvOut').innerHTML=html;renderPreview(seeds,[],'csvPreviewInner');}else{document.getElementById('csvOut').innerHTML=html;}}
async function generateTopic(){const topic=document.getElementById('topicInput').value.trim();const selectedFns=getSelectedFunctions('topicFnGrid');const titlesRaw=document.getElementById('topicTitles').value.trim();const titles=parseTitles(titlesRaw);if(!topic){document.getElementById('topicOut').innerHTML='<p style="font-size:13px;color:#6b7280">Enter a topic first.</p>';return;}if(selectedFns.length===0){document.getElementById('topicOut').innerHTML='<div class="warn-note">Select at least one job function to generate clusters.</div>';return;}if(selectedFns.includes('other')&&!titlesRaw){document.getElementById('topicOut').innerHTML='<div class="warn-note">Job titles are required when "Other" is selected.</div>';return;}document.getElementById('topicOut').innerHTML='<p class="loading-pulse">Building keyword framework...</p>';const firstFn=personaModifiers[selectedFns[0]];const layers=firstFn.layers;const seeds=[topic,...layers.branded.slice(0,2),...layers.category.slice(0,3),...layers.comparison.slice(0,2),...layers.competitor.slice(0,2),...layers.jtbd.slice(0,3)];const uniqueSeeds=[...new Set(seeds)].slice(0,15);const layerMeta=[{key:'branded',label:'Branded intent',desc:'Queries that include your product or category name -- highest purchase intent'},{key:'category',label:'Category definition',desc:'How buyers describe the problem space when they do not yet know your brand'},{key:'comparison',label:'Solution comparison',desc:'Buyers evaluating options -- high intent, needs dedicated landing pages'},{key:'competitor',label:'Competitor alternatives',desc:'Buyers already aware of solutions -- separate campaign, tailored copy required'},{key:'jtbd',label:'Job to be done',desc:'Queries based on what the buyer is trying to accomplish -- often underleveraged in B2B accounts'}];let html=`<div style="margin-bottom:14px">`;layerMeta.forEach(l=>{const layerKws=l.key==='branded'?[topic,...layers[l.key]]:layers[l.key];html+=`<div class="topic-layer"><p class="topic-layer-title">${l.label}</p><p class="topic-layer-desc">${l.desc}</p><div>`;layerKws.slice(0,4).forEach(k=>{const intent=classifyIntent(k);html+=`<span class="kw-tag ${intent==='bofu'?'kw-exact':intent==='mofu'?'kw-phrase':'kw-broad'}">${k}</span>`;});html+=`</div></div>`;});html+=`</div><div id="topicPreviewInner"></div>`;document.getElementById('topicOut').innerHTML=html;renderPreview(uniqueSeeds,titles,'topicPreviewInner');document.getElementById('topicOut').innerHTML+=`<p class="loading-pulse" id="suggestStatus">Fetching real queries <span class="suggest-badge">via Google Suggest</span></p>`;const allSuggestions=new Set();for(const seed of uniqueSeeds.slice(0,5)){try{const r=await fetch(`https://suggestqueries.google.com/complete/search?client=firefox&q=${encodeURIComponent(seed)}`);if(r.ok){const d=await r.json();(d[1]||[]).forEach(s=>allSuggestions.add(s));}}catch(e){}await new Promise(r=>setTimeout(r,150));}const suggestions=[...allSuggestions].filter(s=>!uniqueSeeds.includes(s)).slice(0,20);const statusEl=document.getElementById('suggestStatus');if(statusEl)statusEl.remove();if(suggestions.length){const classified={bofu:[],mofu:[],other:[]};suggestions.forEach(s=>{const isNeg=Object.values(negSignals).some(arr=>arr.some(n=>s.toLowerCase().includes(n)));if(!isNeg){const i=classifyIntent(s);classified[i==='bofu'?'bofu':i==='mofu'?'mofu':'other'].push(s);}});let sugHtml=`<span class="kt-label" style="margin-top:4px">Google Suggest expansion <span class="suggest-badge">via Google Suggest</span></span><div style="margin-bottom:8px">`;classified.bofu.forEach(s=>sugHtml+=`<span class="kw-tag kw-suggest">${s}</span>`);classified.mofu.forEach(s=>sugHtml+=`<span class="kw-tag kw-suggest">${s}</span>`);sugHtml+=`</div>`;document.getElementById('topicOut').innerHTML+=sugHtml;}}
function runAudit(){const raw=document.getElementById('auditInput').value.trim();if(!raw){document.getElementById('auditOut').innerHTML='<p style="font-size:13px;color:#6b7280">Paste search terms to audit.</p>';return;}const terms=raw.split('\n').map(s=>s.trim()).filter(Boolean);let html=`<div class="audit-row audit-head"><span>Search term</span><span>Recommendation</span><span>Reason</span></div>`;terms.forEach(t=>{const tl=t.toLowerCase();let rec,cls,reason;if(negSignals.job.some(s=>tl.includes(s))||negSignals.irrelevant.some(s=>tl.includes(s))){rec='Add as negative';cls='kw-neg';reason='Irrelevant intent';}else if(negSignals.freeOnly.some(s=>tl.includes(s))){rec='Add as negative';cls='kw-neg';reason='Free-only seeker';}else if(negSignals.educational.some(s=>tl.includes(s))&&classifyIntent(t)==='tofu'){rec='Negative (or TOFU only)';cls='kw-neg';reason='Research / educational intent';}else if(negSignals.competitor.some(s=>tl.includes(s))){rec='Dedicated ad group';cls='kw-phrase';reason='Comparison query -- needs tailored copy + LP';}else if(classifyIntent(t)==='bofu'){rec='Promote to exact';cls='kw-exact';reason='High commercial intent';}else if(classifyIntent(t)==='mofu'){rec='Keep as phrase';cls='kw-phrase';reason='Mid-funnel -- monitor CVR';}else{rec='Negative or TOFU content';cls='kw-neg';reason='Low conversion probability';}html+=`<div class="audit-row"><span style="color:#111827">${t}</span><span><span class="kw-tag ${cls}" style="margin:0">${rec}</span></span><span style="color:#6b7280;font-size:12px">${reason}</span></div>`;});document.getElementById('auditOut').innerHTML=`<div>${html}</div>`;}
function genNegatives(){const raw=document.getElementById('negInput').value.trim();if(!raw){document.getElementById('negOut').innerHTML='<p style="font-size:13px;color:#6b7280">Paste search terms first.</p>';return;}const terms=raw.split('\n').map(s=>s.trim()).filter(Boolean);const buckets={job:[],freeOnly:[],educational:[],irrelevant:[],competitor:[],keep:[]};terms.forEach(t=>{const tl=t.toLowerCase();let placed=false;for(const[cat,sigs]of Object.entries(negSignals)){if(sigs.some(s=>tl.includes(s))){buckets[cat].push(t);placed=true;break;}}if(!placed)buckets.keep.push(t);});const meta={job:{label:'Job seekers',action:'Negative immediately',cls:'kw-neg'},freeOnly:{label:'Free / open source seekers',action:'Negative unless you have freemium',cls:'kw-neg'},educational:{label:'Educational / certification intent',action:'Negative unless you have TOFU content',cls:'kw-neg'},irrelevant:{label:'Off-topic / irrelevant',action:'Negative immediately',cls:'kw-neg'},competitor:{label:'Competitor comparisons',action:'Keep -- build dedicated comparison ad group',cls:'kw-phrase'},keep:{label:'Worth keeping',action:'Monitor CVR -- evaluate for exact promotion',cls:'kw-phrase'}};let html='';Object.entries(buckets).forEach(([cat,list])=>{if(!list.length)return;const m=meta[cat];html+=`<div class="kt-card"><div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:6px"><span style="font-size:14px;font-weight:500;color:#111827">${m.label}</span><span style="font-size:11px;color:#6b7280">${list.length} term${list.length>1?'s':''}</span></div><p style="font-size:12px;color:#6b7280;margin-bottom:8px">${m.action}</p><div>`;list.forEach(t=>{html+=`<span class="kw-tag ${m.cls}">${t}</span>`;});html+=`</div></div>`;});document.getElementById('negOut').innerHTML=html;}
document.addEventListener('DOMContentLoaded',()=>{const root=document.getElementById('keyword-tool-root');root.innerHTML=`<div class="kt-wrap"><div class="kt-tab-row"><button class="kt-tab active" onclick="switchTab('manual',this)">Manual seeds</button><button class="kt-tab" onclick="switchTab('csv',this)">CSV upload</button><button class="kt-tab" onclick="switchTab('topic',this)">Topic generator</button><button class="kt-tab" onclick="switchTab('audit',this)">Audit + negatives</button></div><div id="kt-tab-manual"><span class="kt-label">1. Seed keywords (one per line)</span><textarea id="seedInput" class="kt-textarea" rows="4" style="margin-bottom:14px" placeholder="data integration&#10;etl pipeline&#10;salesforce connector&#10;cloud data warehouse&#10;data pipeline tool"></textarea><span class="kt-label">2. Job function/s <span class="li-note">Matches LinkedIn job functions</span></span><div class="fn-checkbox-wrap" id="manualFnWrap"><p class="fn-placeholder" id="manualFnPlaceholder">Select job function/s</p><div class="fn-grid" id="manualFnGrid" style="display:none"></div><p class="fn-count" id="manualFnCount"></p><div id="manualFnWarning"></div><p class="fn-other-note" id="manualOtherNote">Job titles are required when "Other" is selected.</p></div><span class="kt-label" style="margin-top:10px">3. Job titles <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:11px;color:#9ca3af">(optional unless "Other" is selected)</span></span><input id="titlesInput" type="text" class="kt-input" placeholder="VP of Data Engineering, Head of Analytics, Director of Data" style="margin-bottom:4px"><p id="titlesNote" class="optional-note">Optional but recommended. Up to 15 titles separated by commas. Sharpens exact match variants and doubles as your LinkedIn and Customer Match seed list.</p><div style="display:flex;gap:10px;margin:12px 0;flex-wrap:wrap"><label style="font-size:13px;display:flex;align-items:center;gap:4px"><input type="checkbox" id="chkE" checked> Exact</label><label style="font-size:13px;display:flex;align-items:center;gap:4px"><input type="checkbox" id="chkP" checked> Phrase</label><label style="font-size:13px;display:flex;align-items:center;gap:4px"><input type="checkbox" id="chkB"> Broad</label></div><button class="kt-btn" onclick="buildManual()">Build clusters</button><div id="manualPreview" style="margin-top:16px"></div><div id="manualOut"></div><div class="kt-explainer" style="margin-top:16px"><div class="kt-explainer-toggle" onclick="toggleExplainer('multiSelectBody','multiSelectChev')"><span>Recommendations for selecting job functions</span><span id="multiSelectChev" style="font-size:14px;transition:transform .2s">›</span></div><div class="kt-explainer-body" id="multiSelectBody"><p style="margin-bottom:8px">Job functions map directly to LinkedIn Campaign Manager audience targeting.</p><p style="margin-bottom:6px"><strong style="color:#111827">Select one function</strong> when your ICP is clearly defined and sits within a single department.</p><p style="margin-bottom:6px"><strong style="color:#111827">Select two to three functions</strong> when your buyer spans multiple departments. Each function generates its own cluster group.</p><p style="margin-bottom:6px"><strong style="color:#111827">Avoid selecting four or more</strong> unless doing exploratory research.</p><p style="margin-bottom:6px"><strong style="color:#111827">Select "Other" only</strong> when your ICP falls outside LinkedIn's taxonomy. Job titles become required.</p><p style="font-size:12px;color:#9ca3af;margin-top:8px">Mirror this selection in your LinkedIn Campaign Manager audience setup for ICP consistency across channels.</p></div></div></div><div id="kt-tab-csv" style="display:none"><span class="kt-label">Time window</span><div style="display:flex;gap:8px;margin-bottom:6px;flex-wrap:wrap"><label style="font-size:13px;display:flex;align-items:center;gap:4px"><input type="radio" name="window" value="30"> 30 days</label><label style="font-size:13px;display:flex;align-items:center;gap:4px"><input type="radio" name="window" value="90"> 90 days</label><label style="font-size:13px;display:flex;align-items:center;gap:4px"><input type="radio" name="window" value="180" checked> 6 months <span style="font-size:11px;color:#2563eb;margin-left:4px">Recommended</span></label><label style="font-size:13px;display:flex;align-items:center;gap:4px"><input type="radio" name="window" value="365"> 12 months</label></div><div id="windowNote" style="margin-bottom:14px"></div><span class="kt-label">Paste CSV data</span><p style="font-size:12px;color:#9ca3af;margin-bottom:6px">Export from Google Ads: Keywords > Download. Required columns: <strong style="color:#111827">Keyword, Match type, Conversions, Cost</strong>. Optional: <strong style="color:#111827">Impr. share</strong></p><textarea id="csvInput" class="kt-textarea" rows="7" style="margin-bottom:10px;font-family:monospace;font-size:13px" placeholder="Keyword,Match type,Conversions,Cost,Impr. share&#10;data integration,Exact,12,480,0.62&#10;etl pipeline,Phrase,8,320,0.41&#10;free etl tool,Broad,0,45,0.12"></textarea><button class="kt-btn" onclick="analyzeCSV()">Analyze keywords</button><div id="csvOut" style="margin-top:16px"></div><div class="kt-explainer" style="margin-top:16px"><div class="kt-explainer-toggle" onclick="toggleExplainer('isExplainer','isChev')"><span>How impression share is used in this tool</span><span id="isChev" style="font-size:14px;transition:transform .2s">›</span></div><div class="kt-explainer-body" id="isExplainer"><p style="margin-bottom:8px">IS is a <strong style="color:#111827">secondary signal</strong>. Conversion volume and cost efficiency drive clustering. IS layers in as a strategic flag:</p><p style="margin-bottom:6px"><span class="is-flag is-protect">Protect and deepen</span> High IS + strong conversions.</p><p style="margin-bottom:6px"><span class="is-flag is-scale">Scale opportunity</span> Low IS + strong conversions.</p><p style="margin-bottom:6px"><span class="is-flag is-efficiency">Efficiency problem</span> High IS + weak conversions.</p><p style="margin-bottom:8px"><span class="is-flag is-deprioritize">Deprioritize</span> Low IS + weak conversions.</p><p style="font-size:12px;color:#9ca3af">Always lead with pipeline impact over IS.</p></div></div></div><div id="kt-tab-topic" style="display:none"><span class="kt-label">Topic or product category</span><input id="topicInput" type="text" class="kt-input" placeholder="e.g. data integration platform, HR software for mid-market" style="margin-bottom:14px"><span class="kt-label">Job function/s <span class="li-note">Matches LinkedIn job functions</span></span><div class="fn-checkbox-wrap" id="topicFnWrap"><p class="fn-placeholder" id="topicFnPlaceholder">Select job function/s</p><div class="fn-grid" id="topicFnGrid" style="display:none"></div><p class="fn-count" id="topicFnCount"></p><div id="topicFnWarning"></div><p class="fn-other-note" id="topicOtherNote">Job titles are required when "Other" is selected.</p></div><span class="kt-label" style="margin-top:10px">Job titles <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:11px;color:#9ca3af">(optional unless "Other" is selected)</span></span><input id="topicTitles" type="text" class="kt-input" placeholder="VP of Engineering, Head of Data, Director of Analytics" style="margin-bottom:4px"><p id="topicTitlesNote" class="optional-note" style="margin-bottom:12px">Optional but recommended. Up to 15 titles separated by commas.</p><button class="kt-btn" onclick="generateTopic()">Generate clusters</button><div id="topicOut" style="margin-top:16px"></div><div class="kt-explainer" style="margin-top:16px"><div class="kt-explainer-toggle" onclick="toggleExplainer('suggestBodyTopic','suggestChevTopic')"><span>About Google Suggest data in this tool</span><span id="suggestChevTopic" style="font-size:14px;transition:transform .2s">›</span></div><div class="kt-explainer-body" id="suggestBodyTopic"><p style="margin-bottom:8px">Queries labeled <span class="suggest-badge">via Google Suggest</span> come from Google's autocomplete API. They reflect real queries people are typing.</p><p style="margin-bottom:8px">What Google Suggest <strong style="color:#111827">does not tell you:</strong> search volume, competition level, CPC, or conversion rate.</p><p>Validate volume and intent in Google Ads Keyword Planner before committing budget.</p></div></div></div><div id="kt-tab-audit" style="display:none"><div class="kt-tab-row" style="margin-bottom:12px"><button class="kt-tab active" onclick="switchAuditMode('auditMode',this)" style="font-size:12px;padding:5px 10px">Search term audit</button><button class="kt-tab" onclick="switchAuditMode('negMode',this)" style="font-size:12px;padding:5px 10px">Negative generator</button></div><div id="auditMode"><span class="kt-label">Search terms (paste from Google Ads search term report)</span><textarea id="auditInput" class="kt-textarea" rows="7" style="margin-bottom:10px" placeholder="data pipeline software&#10;etl jobs salary&#10;free data connector&#10;fivetran vs stitch&#10;what is etl"></textarea><button class="kt-btn" onclick="runAudit()">Audit terms</button><div id="auditOut" style="margin-top:16px"></div></div><div id="negMode" style="display:none"><span class="kt-label">Paste search terms to scan</span><textarea id="negInput" class="kt-textarea" rows="7" style="margin-bottom:10px" placeholder="Paste raw search terms here"></textarea><button class="kt-btn" onclick="genNegatives()">Generate negatives</button><div id="negOut" style="margin-top:16px"></div></div></div></div>`;
document.querySelectorAll('input[name="window"]').forEach(r=>r.addEventListener('change',function(){const notes={'30':'<div class="warn-note">30 days may be too thin for B2B SaaS. Consider 90 days minimum.</div>','365':'<div style="background:#f9fafb;border-radius:6px;padding:8px 12px;font-size:12px;color:#6b7280;margin-bottom:8px">12 months may include restructured or paused campaigns.</div>'};document.getElementById('windowNote').innerHTML=notes[this.value]||'';}));
buildFnGrid('manualFnGrid','manualFnPlaceholder','manualFnCount','manualFnWarning','manualOtherNote','titlesInput','titlesNote');
buildFnGrid('topicFnGrid','topicFnPlaceholder','topicFnCount','topicFnWarning','topicOtherNote','topicTitles','topicTitlesNote');
});
