---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KeywordPlanner from '../../components/tools/KeywordPlanner.jsx';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'B2B Paid Search Keyword Planner',
  description: 'A practitioner-built keyword planner for paid search. Build intent clusters, audit your Search Ads CSV, generate negatives.',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://jjcruzgalera.com/tools/keyword-planner',
  author: {
    '@type': 'Person',
    name: 'Javier Cruz Galera',
    url: 'https://jjcruzgalera.com',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  title="B2B Paid Search Keyword Planner"
  description="A practitioner-built keyword planner for paid search. Build intent clusters, audit your Search Ads CSV, generate negatives."
  ogImage="/og-keyword-planner.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>
  <article class="max-w-4xl mx-auto px-6 py-20">
    <header class="mb-10">
      <p class="text-blue-600 font-medium text-sm tracking-wide uppercase mb-3">Tools</p>
      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">
        B2B Paid Search Keyword Planner
      </h1>
      <h2 class="text-xl font-normal text-gray-700 leading-snug mb-4">
        Four entry points into the same intent-based clustering engine, built for B2B SaaS paid search practitioners.
      </h2>
      <p class="text-gray-600 leading-relaxed mb-4">
        Keywords are one input. Start from seed terms, a performing CSV export, or a topic and let the tool generate campaign-ready clusters organized by funnel stage, job function, and match type. Google Suggest integration pulls real queries. Export includes your LinkedIn and Customer Match audience seed alongside the keyword list.
      </p>
      <div class="bg-blue-50 border-l-4 border-blue-500 rounded-r-lg p-4 text-sm text-blue-800 leading-relaxed">
        Keywords are one input. Without clean conversion signals feeding the algorithm, keyword optimization is rearranging deck chairs. <a href="/playbooks/google-ads-ai-native-checklist" class="font-medium underline hover:text-blue-900">See the AI-native account checklist</a> before you scale spend.
      </div>
    </header>
    <KeywordPlanner client:load />
  </article>
  <footer class="max-w-4xl mx-auto px-6 pb-20">
    <div class="border-t border-gray-100 pt-10">
      <p class="text-sm text-gray-400 text-center">jjcruzgalera.com</p>
    </div>
  </footer>
</BaseLayout>

<style is:global>
  #keyword-tool-root * { box-sizing: border-box; margin: 0; padding: 0; }
  .kt-wrap { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 0; }
  .kt-tab-row { display: flex; gap: 6px; margin-bottom: 20px; flex-wrap: wrap; }
  .kt-tab { padding: 6px 14px; border: 0.5px solid #d1d5db; border-radius: 6px; background: transparent; cursor: pointer; font-size: 13px; color: #6b7280; }
  .kt-tab.active { background: #fff; color: #111827; border-color: #9ca3af; }
  .kt-label { font-size: 11px; font-weight: 500; color: #9ca3af; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px; display: block; }
  .kt-input { width: 100%; padding: 8px 10px; font-size: 14px; border: 0.5px solid #d1d5db; border-radius: 6px; background: #fff; color: #111827; font-family: inherit; }
  .kt-input:focus { outline: none; border-color: #2563eb; }
  .kt-textarea { width: 100%; padding: 10px; font-size: 14px; border: 0.5px solid #d1d5db; border-radius: 6px; resize: vertical; background: #fff; color: #111827; font-family: inherit; }
  .kt-textarea:focus { outline: none; border-color: #2563eb; }
  .kt-btn { padding: 8px 20px; cursor: pointer; font-size: 14px; background: #2563eb; color: #fff; border: none; border-radius: 6px; font-family: inherit; }
  .kt-btn:hover { background: #1d4ed8; }
  .kw-tag { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; margin: 3px; }
  .kw-exact { background: #E6F1FB; color: #0C447C; }
  .kw-phrase { background: #EAF3DE; color: #27500A; }
  .kw-broad { background: #FAEEDA; color: #633806; }
  .kw-neg { background: #FCEBEB; color: #791F1F; }
  .kw-title { background: #EEEDFE; color: #3C3489; }
  .kw-suggest { background: #E1F5EE; color: #085041; }
  .suggest-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 500; padding: 1px 6px; border-radius: 10px; background: #E1F5EE; color: #085041; margin-left: 6px; vertical-align: middle; }
  .kt-card { background: #fff; border: 0.5px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 10px; }
  .kt-group-header { display: flex; align-items: center; gap: 8px; padding: 8px 0; border-bottom: 0.5px solid #e5e7eb; margin-bottom: 10px; }
  .kt-group-label { font-size: 13px; font-weight: 500; color: #111827; }
  .kt-group-badge { font-size: 11px; padding: 2px 8px; border-radius: 4px; background: #EEEDFE; color: #3C3489; font-weight: 500; }
  .intent-pill { font-size: 11px; font-weight: 500; padding: 2px 8px; border-radius: 4px; }
  .intent-bofu { background: #E6F1FB; color: #0C447C; }
  .intent-mofu { background: #EAF3DE; color: #27500A; }
  .intent-tofu { background: #FAEEDA; color: #633806; }
  .kt-preview { background: #f9fafb; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 16px; border: 0.5px solid #e5e7eb; }
  .kt-preview-title { font-size: 15px; font-weight: 500; color: #111827; margin-bottom: 4px; }
  .kt-preview-sub { font-size: 12px; color: #6b7280; margin-bottom: 14px; line-height: 1.5; }
  .funnel-bar { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 14px; }
  .funnel-cell { padding: 8px 10px; border-radius: 6px; text-align: center; }
  .funnel-bofu { background: #E6F1FB; } .funnel-mofu { background: #EAF3DE; } .funnel-tofu { background: #FAEEDA; }
  .funnel-count { font-size: 18px; font-weight: 500; }
  .funnel-bofu .funnel-count { color: #0C447C; } .funnel-mofu .funnel-count { color: #27500A; } .funnel-tofu .funnel-count { color: #633806; }
  .funnel-label { font-size: 11px; margin-top: 2px; }
  .funnel-bofu .funnel-label { color: #185FA5; } .funnel-mofu .funnel-label { color: #3B6D11; } .funnel-tofu .funnel-label { color: #854F0B; }
  .campaign-block { background: #fff; border: 0.5px solid #e5e7eb; border-radius: 6px; padding: 10px 14px; margin-bottom: 8px; }
  .campaign-name { font-size: 13px; font-weight: 500; color: #111827; margin-bottom: 2px; }
  .campaign-meta { font-size: 12px; color: #6b7280; margin-bottom: 8px; }
  .adgroup-row { display: flex; align-items: flex-start; gap: 8px; padding: 5px 0; border-bottom: 0.5px solid #f3f4f6; }
  .adgroup-row:last-child { border-bottom: none; }
  .adgroup-name { font-size: 12px; font-weight: 500; color: #111827; min-width: 140px; }
  .adgroup-kws { font-size: 12px; color: #6b7280; line-height: 1.6; }
  .bid-rec { font-size: 12px; color: #6b7280; background: #f9fafb; border-radius: 6px; padding: 8px 12px; margin-top: 8px; line-height: 1.6; }
  .cross-channel { background: #EEEDFE; border-radius: 6px; padding: 10px 14px; margin-top: 10px; }
  .cross-channel-title { font-size: 12px; font-weight: 500; color: #3C3489; margin-bottom: 6px; }
  .cross-channel-sub { font-size: 11px; color: #534AB7; margin-bottom: 6px; line-height: 1.5; }
  .title-tag { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 500; margin: 2px; background: #EEEDFE; color: #3C3489; }
  .audit-row { display: grid; grid-template-columns: minmax(0,2fr) minmax(0,1fr) minmax(0,1.5fr); gap: 8px; padding: 7px 0; border-bottom: 0.5px solid #f3f4f6; align-items: start; font-size: 13px; }
  .audit-row:last-child { border-bottom: none; }
  .audit-head { font-size: 11px; font-weight: 500; color: #9ca3af; text-transform: uppercase; letter-spacing: .05em; padding-bottom: 6px; border-bottom: 0.5px solid #e5e7eb; }
  .kt-export { background: #f9fafb; border-radius: 6px; padding: 10px 14px; margin-top: 8px; font-size: 12px; font-family: monospace; color: #6b7280; white-space: pre-wrap; word-break: break-all; max-height: 140px; overflow-y: auto; }
  .kt-copy-btn { font-size: 12px; padding: 4px 12px; cursor: pointer; margin-top: 6px; background: #f3f4f6; border: 0.5px solid #d1d5db; border-radius: 4px; font-family: inherit; }
  .is-flag { display: inline-flex; align-items: center; padding: 2px 7px; border-radius: 4px; font-size: 11px; font-weight: 500; margin-left: 6px; }
  .is-protect { background: #EAF3DE; color: #27500A; }
  .is-scale { background: #E6F1FB; color: #0C447C; }
  .is-efficiency { background: #FAEEDA; color: #633806; }
  .is-deprioritize { background: #F1EFE8; color: #444441; }
  .gap-flag { background: #FCEBEB; color: #791F1F; font-size: 11px; font-weight: 500; padding: 2px 7px; border-radius: 4px; }
  .perf-card { background: #fff; border: 0.5px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 10px; }
  .perf-metrics { display: flex; gap: 16px; flex-wrap: wrap; margin: 6px 0 10px; }
  .perf-metric { font-size: 12px; color: #6b7280; }
  .perf-metric strong { color: #111827; font-weight: 500; }
  .topic-layer { background: #f9fafb; border-radius: 6px; padding: 10px 14px; margin-bottom: 8px; }
  .topic-layer-title { font-size: 12px; font-weight: 500; color: #111827; margin-bottom: 6px; }
  .topic-layer-desc { font-size: 11px; color: #6b7280; margin-bottom: 8px; line-height: 1.5; }
  .loading-pulse { font-size: 12px; color: #9ca3af; font-style: italic; padding: 8px 0; }
  .fn-checkbox-wrap { border: 0.5px solid #e5e7eb; border-radius: 10px; padding: 10px 14px; margin-bottom: 6px; background: #fff; }
  .fn-placeholder { font-size: 13px; font-style: italic; color: #9ca3af; padding: 4px 0; }
  .fn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px; }
  .fn-item { display: flex; align-items: center; gap: 8px; padding: 5px 0; font-size: 13px; color: #111827; cursor: pointer; border-radius: 4px; }
  .fn-item input[type=checkbox] { width: 15px; height: 15px; flex-shrink: 0; cursor: pointer; accent-color: #2563eb; }
  .fn-count { font-size: 11px; color: #9ca3af; margin-top: 4px; }
  .fn-other-note { font-size: 12px; color: #A32D2D; margin-top: 6px; font-weight: 500; display: none; }
  .li-note { font-size: 11px; color: #2563eb; background: #E6F1FB; padding: 2px 7px; border-radius: 4px; margin-left: 6px; font-weight: 500; }
  .optional-note { font-size: 12px; color: #9ca3af; margin-top: 5px; line-height: 1.5; }
  .required-note { font-size: 12px; color: #A32D2D; margin-top: 5px; line-height: 1.5; font-weight: 500; }
  .warn-note { background: #FAEEDA; border-left: 3px solid #BA7517; border-radius: 0 6px 6px 0; padding: 8px 12px; font-size: 12px; color: #633806; line-height: 1.5; margin-bottom: 8px; }
</style>
