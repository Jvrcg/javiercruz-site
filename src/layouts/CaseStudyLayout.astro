---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  tag: string;
  company: string;
  industry: string;
  duration: string;
  datePublished: string;
  results: { label: string; value: string }[];
}

const {
  title,
  description,
  tag,
  company,
  industry,
  duration,
  datePublished,
  results,
} = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": "Javier Cruz",
    "url": "https://javiercruz.com"
  },
  "publisher": {
    "@type": "Person",
    "name": "Javier Cruz",
    "url": "https://javiercruz.com"
  },
  "datePublished": datePublished,
  "url": new URL(Astro.url.pathname, 'https://javiercruz.com').href,
};
---

<BaseLayout title={`${title} — Case Study | Javier Cruz`} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <article class="max-w-2xl mx-auto px-6 py-20">

    <!-- Back link -->
    <nav class="mb-12" aria-label="Breadcrumb">
      <a href="/case-studies" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">
        ← All case studies
      </a>
    </nav>

    <!-- Header -->
    <header class="mb-16">
      <p class="text-xs font-medium text-blue-600 uppercase tracking-wide mb-3">{tag}</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight mb-6">
        {title}
      </h1>
      <p class="text-lg text-gray-600">{description}</p>

      <!-- Meta strip -->
      <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-b border-gray-100 py-6">
        <div>
          <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Company</dt>
          <dd class="text-sm font-medium text-gray-900">{company}</dd>
        </div>
        <div>
          <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Industry</dt>
          <dd class="text-sm font-medium text-gray-900">{industry}</dd>
        </div>
        <div>
          <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Duration</dt>
          <dd class="text-sm font-medium text-gray-900">{duration}</dd>
        </div>
      </dl>
    </header>

    <!-- Results highlight -->
    <section aria-labelledby="results-heading" class="mb-16 bg-blue-50 rounded-xl p-8">
      <h2 id="results-heading" class="text-sm font-semibold text-blue-700 uppercase tracking-wide mb-6">
        Key Results
      </h2>
      <dl class="grid grid-cols-3 gap-6">
        {results.map(r => (
          <div>
            <dd class="text-2xl font-bold text-gray-900 mb-1">{r.value}</dd>
            <dt class="text-xs text-gray-500">{r.label}</dt>
          </div>
        ))}
      </dl>
    </section>

    <!-- Body content -->
    <div class="prose prose-gray max-w-none">
      <slot />
    </div>

    <!-- Footer nav -->
    <footer class="mt-20 border-t border-gray-100 pt-10">
      <a
        href="/case-studies"
        class="text-sm text-blue-600 hover:text-blue-700 font-medium transition-colors"
      >
        ← Back to all case studies
      </a>
    </footer>

  </article>
</BaseLayout>
