{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "astro",
  "redirects": [
    {
      "source": "/tools/keyword-planner",
      "destination": "/tools",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*).xlsx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"syncflow_attribution_template.xlsx\""
        }
      ]
    },
    {
      "source": "/data/(.*).csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"syncflow_prospects.csv\""
        }
      ]
    }
  ]
}
